{
  "name": "chatgpt-offer-toolkit",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser ChatGPT offer toolkit by ePlus.DEV",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "zip": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "npm run zip && npm run zip:firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "wxt": "0.21.5",
    "typescript": "5.9.3"
  }
}
