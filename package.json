{
  "name": "chatgpt-offer-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generate ChatGPT Business promotional checkout links, visit the official offer page, and manage updates. Built by ePlus.DEV.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && wxt -b chrome --mv3",
    "dev:firefox": "node scripts/generate-icons.mjs && wxt -b firefox --mv3",
    "build": "node scripts/generate-icons.mjs && wxt build -b chrome --mv3",
    "build:firefox": "node scripts/generate-icons.mjs && wxt build -b firefox --mv3",
    "build:all": "node scripts/generate-icons.mjs && wxt build -b chrome --mv3 && wxt build -b firefox --mv3",
    "zip": "node scripts/generate-icons.mjs && wxt zip -b chrome --mv3",
    "zip:firefox": "node scripts/generate-icons.mjs && wxt zip -b firefox --mv3",
    "zip:all": "node scripts/generate-icons.mjs && wxt zip -b chrome --mv3 && wxt zip -b firefox --mv3",
    "postinstall": "node scripts/generate-icons.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:popup": "node scripts/popup-preview.mjs"
  },
  "devDependencies": {
    "wxt": "0.21.5",
    "vite": "7.3.8",
    "typescript": "5.9.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "@tailwindcss/vite": "4.1.13",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "motion": "12.23.12",
    "lucide-react": "0.468.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  }
}
